# Beispiel-VHost für den bestehenden Host-Nginx auf dem Netcup-Rootserver.
# TLS-Terminierung erfolgt hier. Die Anwendung lauscht nur auf 127.0.0.1:APP_PORT
# (Standard 8182). Keine Zertifikatsverwaltung in den Anwendungscontainern.
#
# Installation (Beispiel):
#   sudo cp deploy/nginx/essen.faustens.de.conf.example /etc/nginx/sites-available/essen.faustens.de.conf
#   # Pfade und Upstream-Port anpassen, Zertifikat mit Certbot einrichten
#   sudo ln -s /etc/nginx/sites-available/essen.faustens.de.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Certbot (nach dem ersten HTTP-VHost):
#   sudo certbot --nginx -d essen.faustens.de
#
# Vertrauensgrenze: Dieser VHost überschreibt Forwarded-Header. Clients können keine
# X-Forwarded-*-Werte durchreichen. Siehe docs/deployment.md.

upstream was_essen_wir_frontend {
    server 127.0.0.1:8182;
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name essen.faustens.de;

    # Certbot Challenge; übriger HTTP-Verkehr wird auf HTTPS umgeleitet.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name essen.faustens.de;

    # Certbot oder manuelle Zertifikate – Platzhalter, keine echten Secrets im Repository.
    ssl_certificate     /etc/letsencrypt/live/essen.faustens.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/essen.faustens.de/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # HSTS nur auf HTTPS. Kein includeSubDomains / preload ohne ausdrückliche Freigabe.
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 1m;

    # Kontrolliertes Setzen der Proxy-Header (Überschreiben, nicht Anhängen).
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection        "";
    proxy_http_version 1.1;

    proxy_connect_timeout 5s;
    proxy_send_timeout    45s;
    proxy_read_timeout    45s;

    location / {
        proxy_pass http://was_essen_wir_frontend;
    }
}
