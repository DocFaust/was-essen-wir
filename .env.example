# Copy to .env and replace the password locally. Do not commit .env.
POSTGRES_DB=wasessenwir
POSTGRES_USER=wasessenwir
POSTGRES_PASSWORD=CHANGE_ME_LOCALLY
APP_PORT=8080
# Production override (compose.prod.yaml) defaults to 8182 and binds only to 127.0.0.1.
# APP_PORT=8182
POSTGRES_PORT=5432
TZ=Europe/Berlin

# Optional JVM flags for the backend container.
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# Used only when the backend runs on the host, outside Compose.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wasessenwir
# SPRING_DATASOURCE_USERNAME=wasessenwir
# SPRING_DATASOURCE_PASSWORD=CHANGE_ME_LOCALLY

# Session cookie. Leave false while the app is served over HTTP in the home network.
# compose.prod.yaml forces Secure cookies and rejects insecure combinations.
# APP_SESSION_COOKIE_SECURE=false
# APP_REQUIRE_SECURE_COOKIES=false
# APP_FORWARD_CLIENT_IP=false
# Production Compose uses network 172.30.90.0/24; keep trusted proxies aligned.
# APP_TRUSTED_PROXIES=172.30.90.0/24
# APP_MAX_REQUEST_SIZE=256KB
# APP_SESSION_TIMEOUT=12h

# Optional resource limits for compose.prod.yaml (examples):
# BACKEND_MEMORY_LIMIT=768m
# POSTGRES_MEMORY_LIMIT=512m
# FRONTEND_MEMORY_LIMIT=128m

# Optional persistent login on this browser. The secret is only stored as a hash.
# APP_REMEMBER_ME_ENABLED=true
# APP_REMEMBER_ME_DURATION=P30D

# Setup token lifetime. Rotation is only for an unfinished first-time setup.
# APP_SETUP_TOKEN_TTL=PT24H
# APP_SETUP_ROTATE_TOKEN=false

# In-memory attempt limiter capacity (login, password change, setup). Per backend instance.
# APP_LOGIN_MAX_ATTEMPTS=8
# APP_LOGIN_WINDOW=PT15M
# APP_SETUP_MAX_ATTEMPTS=8
# APP_SETUP_WINDOW=PT15M
# APP_ATTEMPT_LIMITER_MAX_KEYS=10000

# Optional meal assistant. Leave disabled to run without any AI provider.
# AI_ENABLED=false
# AI_PROVIDER=ollama
# fixture is only for automated tests / controlled local runs (needs AI_ALLOW_FIXTURE=true outside Spring profile test).
# AI_ALLOW_FIXTURE=false
# AI_MAX_INPUT_LENGTH=500
# AI_MAX_OUTPUT_TOKENS=1024
# Shared AI usage limits (in-memory, per backend instance; reset on restart):
# AI_RATE_LIMIT_PER_USER_PER_MINUTE=5
# AI_RATE_LIMIT_PER_USER_PER_DAY=50
# AI_RATE_LIMIT_GLOBAL_PER_DAY=150
# AI_MAX_CONCURRENT_PER_USER=1
# AI_MAX_CONCURRENT_GLOBAL=3
# AI_RATE_LIMIT_MAX_TRACKED_USERS=1000
# From the backend container, 127.0.0.1 is the container itself.
# Point Ollama at another computer in the home network by LAN address or DNS name:
# OLLAMA_BASE_URL=http://192.168.1.20:11434
# OLLAMA_BASE_URL=http://ollama.home:11434
# OLLAMA_MODEL=qwen3.5:9b
# Provider timeout default 30s; keep below the internal nginx /api/ai/ proxy timeout (45s).
# OLLAMA_TIMEOUT=30s
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TIMEOUT=30s
