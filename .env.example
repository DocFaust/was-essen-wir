# Copy to .env and replace the password locally. Do not commit .env.
POSTGRES_DB=wasessenwir
POSTGRES_USER=wasessenwir
POSTGRES_PASSWORD=CHANGE_ME_LOCALLY
APP_PORT=8080
POSTGRES_PORT=5432
TZ=Europe/Berlin

# Optional JVM flags for the backend container.
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0

# Used only when the backend runs on the host, outside Compose.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wasessenwir
# SPRING_DATASOURCE_USERNAME=wasessenwir
# SPRING_DATASOURCE_PASSWORD=CHANGE_ME_LOCALLY

# Session cookie. Leave false while the app is served over HTTP in the home network.
# Set true only after HTTPS terminates in front of the frontend.
# APP_SESSION_COOKIE_SECURE=false
# APP_SESSION_TIMEOUT=12h

# Optional persistent login on this browser. The secret is only stored as a hash.
# APP_REMEMBER_ME_ENABLED=true
# APP_REMEMBER_ME_DURATION=P30D

# Setup token lifetime. Rotation is only for an unfinished first-time setup.
# APP_SETUP_TOKEN_TTL=PT24H
# APP_SETUP_ROTATE_TOKEN=false

# Optional meal assistant. Leave disabled to run without any AI provider.
# AI_ENABLED=false
# AI_PROVIDER=ollama
# From the backend container, 127.0.0.1 is the container itself.
# Point Ollama at another computer in the home network by LAN address or DNS name:
# OLLAMA_BASE_URL=http://192.168.1.20:11434
# OLLAMA_BASE_URL=http://ollama.home:11434
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_TIMEOUT=30s
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TIMEOUT=30s
